Get-NetTCPConnection -LocalPort 5173 | Select-Object -ExpandProperty OwningProcess -Unique | Stop-Process -Force# Copy to .env (or export as real environment variables) — never commit real secrets.

SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/medicompare?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change_me
DDL_AUTO=update
SQL_INIT_MODE=never
SHOW_SQL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=replace_with_a_long_random_256_bit_secret
JWT_ACCESS_EXPIRY_MS=3600000
JWT_REFRESH_EXPIRY_MS=604800000

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Razorpay — leave blank to run in mock payment mode (safe for local/demo use)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK_MODE=true

# Google Maps server-side key (Places/Geocoding), if used — never expose this one in the frontend
GOOGLE_MAPS_SERVER_API_KEY=

# Email (SMTP) — leave MAIL_HOST blank to run in mock mode (emails are logged, not sent)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@medicompare.demo

LOG_LEVEL=DEBUG
